# Back on a phone by a finger drawn to the right across the conversation:
# the page follows the finger over the inbox it goes back to, goes back
# where it was if lifted early, and goes back to the inbox if drawn far.
# Escape (the back key) closes the new conversation's sheet first.
# size: 400x800
# env: AIDDICTION_INPUT=touch
until:page=inbox
until:projects=1
wait:1000
click:286,676
until:dialog=open
wait:600
key:escape
until:dialog=closed
expect:page=inbox
wait:600
click:286,676
until:dialog=open
wait:800
click:200,643
wait:800
click:200,764
wait:800
click:200,730
type:please make a file
click:354,442
until:page=chat
until:permissions=1
wait:500
# Halfway (and a bit less), finger still down: the inbox shows under it.
hold:60,400,150,0
wait:300
shot:phone-swipe-back-held
expect:page=chat
# Lifted there: the conversation comes back.
lift
wait:600
expect:page=chat
shot:phone-swipe-back-returned
# Far: back to the inbox.
swipe:60,400,250,0
until:page=inbox
wait:500
shot:phone-swipe-back-inbox
quit
