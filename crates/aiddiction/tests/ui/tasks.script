# The project's board: a card made from a column's plus button, edited by a
# click, moved to the next column and deleted.
# size: 1100x760
until:page=inbox
until:projects=1
wait:500
click:28,168
until:page=projects
click:220,110
until:page=project
wait:500
shot:tasks-board
# Todo's plus button.
click:600,197
until:dialog=open
type:Write the README
wait:300
shot:tasks-new
key:enter
until:tasks=1
until:dialog=closed
wait:500
shot:tasks-created
# Its right arrow: to In progress.
click:575,270
wait:800
shot:tasks-moved
expect:dialog=closed
expect:tasks=1
# A click on the card edits it; Enter in the title saves.
click:730,243
until:dialog=open
key:end
type: and the docs
key:enter
until:dialog=closed
wait:800
shot:tasks-edited
# Its delete button.
click:819,296
until:tasks=0
wait:300
shot:tasks-deleted
quit
