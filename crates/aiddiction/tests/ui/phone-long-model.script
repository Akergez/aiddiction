# The phone with an agent whose model has a long name: the composer keeps the
# name in its button and send in reach, not off the edge of the card.
# size: 400x800
# env: AIDDICTION_INPUT=touch FAKE_AGENT_LONG_MODEL=1
until:page=inbox
until:projects=1
wait:1000
click:356,676
until:dialog=open
wait:800
# The agent: a sheet of the server's agents.
click:200,528
wait:800
click:200,764
wait:800
click:200,730
type:please make a file
# Start.
click:354,324
until:page=chat
until:permissions=1
wait:500
expect:model=fake-long
shot:phone-long-model
quit
