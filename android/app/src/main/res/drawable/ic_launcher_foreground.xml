            android:pathData="M 32 45 L 38 39 L 59 60 L 38 81 L 32 75 L 47 60 Z M 62 74 H 84 A 5 5 0 0 1 84 84 H 62 A 5 5 0 0 1 62 74 Z" />
        <!-- The agent -->
        <path
            android:fillColor="#c88800"
            android:pathData="M 92 34 A 10 10 0 1 1 92 54 A 10 10 0 1 1 92 34 Z" />
        <path
            android:fillColor="#f6d32d"
