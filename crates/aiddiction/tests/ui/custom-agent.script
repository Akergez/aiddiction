# A custom agent added in the settings: the server keeps it, and it joins
# the agents every client sees.
# size: 1100x760
until:page=inbox
wait:1000
click:28,728
until:page=settings
click:220,105
until:page=agents
until:agents=3
wait:300
click:1030,16
until:dialog=open
type:My fake
key:tab
type:/src/target/debug/aiddiction-fake-agent
wait:200
shot:custom-agent-form
key:enter
until:agents=4
wait:300
shot:custom-agent-added
quit
