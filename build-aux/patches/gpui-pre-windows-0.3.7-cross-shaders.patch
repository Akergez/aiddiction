+// script is the *host*: cross-compiled from Linux it did nothing, and the
+// release build then failed on the missing `shaders_bytes.rs`. Here the
+// question is asked of the target, and on another host `fxc.exe` is run
+// through wine (or whatever `GPUI_FXC_RUNNER` names).
 fn main() {
-    #[cfg(target_os = "windows")]
-    {
-        // Compile HLSL shaders
-        #[cfg(not(debug_assertions))]
-        compile_shaders();
+    println!("cargo:rerun-if-env-changed=GPUI_FXC_PATH");
+    println!("cargo:rerun-if-env-changed=GPUI_FXC_RUNNER");
+    if std::env::var("CARGO_CFG_TARGET_OS").as_deref() != Ok("windows") {
+        return;
     }
+    // Compile HLSL shaders
+    #[cfg(not(debug_assertions))]
+    compile_shaders();
 }
 
