# The review loop: a conversation started from the project's page, the
# project's diff (the demo's sample repository) annotated from the
# conversation's bar, the annotations sent back to that conversation as a
# prompt, and the review empty again for the next round.
# size: 1100x760
until:page=inbox
until:projects=1
wait:500
# Sample repo, then a conversation with the fake agent from its page.
click:28,140
until:page=projects
click:220,60
until:page=project
wait:300
click:987,16
until:dialog=open
click:550,217
wait:400
type:fake
key:enter
wait:300
click:550,300
type:hello
key:enter
until:page=chat
until:busy=no
# "Review" in the bar.
click:972,16
until:page=review
wait:1500
expect:annotations=0
# src/lib.rs in the tree; the cursor starts on its first change.
click:170,108
wait:600
key:a
until:dialog=open
type:refactor this hunk to return a Result
click:654,304
until:dialog=closed
expect:annotations=1
wait:300
shot:review-annotated
# Send to agent.
click:1050,49
until:page=chat
until:busy=no
wait:500
shot:review-sent
click:972,16
until:page=review
expect:annotations=0
quit
