# A conversation started in one step from the inbox — project, agent (found
# by typing in its list), first message —, the agent's question answered
# from the inbox's row without the conversation's own card, and the turn
# finished.
# size: 1100x760
until:page=inbox
until:projects=1
wait:800
expect:sessions=0
click:748,452
until:dialog=open
# The agent: its list is searchable.
click:550,229
wait:400
type:fake
key:enter
wait:300
# The message; Enter starts.
click:550,318
type:please make a file
key:enter
until:page=chat
until:permissions=1
expect:busy=yes
expect:sessions=1
until:waiting=1
wait:300
shot:first-chat-permission
# Allow, in the inbox's row.
click:156,228
until:busy=no
expect:permissions=0
expect:waiting=0
wait:500
shot:first-chat-done
quit
