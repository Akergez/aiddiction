# The composer: slash commands, a multiline draft, and sending with its button.
# size: 1100x760
until:page=inbox
until:projects=1
wait:800
click:378,16
until:dialog=open
click:550,217
wait:400
type:fake
key:enter
wait:300
click:550,300
type:please make a file
key:enter
until:page=chat
until:permissions=1
click:246,180
until:busy=no
wait:500
click:700,705
type:/
wait:300
shot:composer-commands
click:550,629
wait:300
shot:composer-command-picked
type:look at this
wait:300
shot:composer-command-typed
key:shift-enter
type:second line
wait:300
shot:composer-draft
expect:entries=4
# Sent: the message and the agent's answer come into the conversation.
# Not busy=yes: the fake agent's turn may be over before a slow frame.
click:1066,729
until:entries=6
until:busy=no
wait:500
shot:composer-sent
# The mode is a menu under its button on a pointer.
click:458,729
wait:400
shot:composer-mode
click:460,735
wait:400
shot:composer-mode-auto
expect:mode=auto
# Opened again from the inbox, the conversation is attached to, not
# created: the mode is still offered, as it was left.
click:1056,16
until:chats=0
click:228,110
until:page=chat
until:mode=auto
wait:500
shot:composer-reopened
quit
