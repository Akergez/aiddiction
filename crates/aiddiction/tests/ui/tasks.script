# The project's board: a card made from a column's plus button, edited by a
# click, moved to the next column and deleted. The titles are short so that
# no font wraps them: the card's buttons are under the title.
# size: 1100x760
until:page=inbox
until:projects=1
wait:500
click:28,140
until:page=projects
click:220,60
until:page=project
wait:500
shot:tasks-board
# Todo's plus button.
click:605,118
until:dialog=open
type:Docs
wait:300
shot:tasks-new
key:enter
until:tasks=1
until:dialog=closed
wait:500
shot:tasks-created
# Its right arrow, in the bar over the card: to In progress.
click:568,155
wait:800
shot:tasks-moved
expect:dialog=closed
expect:tasks=1
# A click on the card edits it; Enter in the title saves.
click:700,172
until:dialog=open
key:end
type: now
key:enter
until:dialog=closed
wait:800
shot:tasks-edited
# Its delete button, in the bar.
click:830,155
until:tasks=0
wait:300
shot:tasks-deleted
quit
